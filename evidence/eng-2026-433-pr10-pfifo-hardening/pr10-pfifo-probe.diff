+static size_t pgraph_packet_test_length(PGRAPHState *pg, unsigned int method)
+{
+    return method == NV097_INLINE_ARRAY ? pg->inline_array_length
+                                        : pg->inline_elements_length;
+}
+
+static void pgraph_packet_test_event(PGRAPHState *pg, unsigned int method,
+                                     bool inc, bool tracing, const char *mode,
+                                     const char *action,
+                                     size_t num_words_available,
+                                     size_t num_words_consumed,
+                                     size_t length_before,
+                                     size_t draw_arrays_before)
+{
+    static FILE *output;
+    static uint64_t sequence;
+    const char *path = getenv("XEMU_PFIFO_PACKET_TEST_OUTPUT");
+
+    if (!path || !*path) {
+        return;
+    }
+    if (!output) {
+        output = fopen(path, "w");
+        if (!output) {
+            return;
+        }
+        fprintf(output,
+                "sequence,method,inc,tracing,mode,action,available_words,"
+                "consumed_words,length_before,length_after,"
+                "draw_arrays_before,draw_arrays_after\n");
+    }
+    fprintf(output, "%" PRIu64 ",0x%04x,%d,%d,%s,%s,%zu,%zu,%zu,%zu,%zu,%u\n",
+            ++sequence, method, inc, tracing, mode, action,
+            num_words_available, num_words_consumed, length_before,
+            pgraph_packet_test_length(pg, method), draw_arrays_before,
+            pg->draw_arrays_length);
+    fflush(output);
+}
+#endif
