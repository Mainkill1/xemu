{
  "capabilities": [
    "executableHashResults",
    "pinnedBaseline",
    "serverComparison",
    "compactReports"
  ],
  "result": "/api/v1/build-results/{sha256}",
  "comparison": "/api/v1/compare?A={sha256}&B={sha256}",
  "baseline": "/api/v1/baseline",
  "formats": [
    "json",
    "markdown",
    "csv (comparison only)"
  ],
  "rule": "A omitted uses the explicitly pinned baseline. No first/latest baseline is selected automatically. Indexing reads archived evidence, never starts tests.",
  "index": "POST /api/v1/build-results/index {runId}",
  "indexStatus": "/api/v1/build-results/index-status"
}