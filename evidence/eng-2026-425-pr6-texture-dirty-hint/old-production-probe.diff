+#ifdef XEMU_TEXTURE_REVALIDATION_TEST
+static void pgraph_vk_texture_revalidation_test_event(
+    const char *event, unsigned int texture_idx, const void *binding,
+    uint64_t texture_offset, uint64_t texture_length,
+    uint64_t palette_offset, uint64_t palette_length, uint64_t content_hash,
+    uint64_t stored_hash, int content_changed, int upload_succeeded,
+    int dirty_hint)
+{
+    static FILE *output;
+    static uint64_t sequence;
+    const char *path = getenv("XEMU_TEXTURE_REVALIDATION_TEST_OUTPUT");
+
+    if (!path || !*path) {
+        return;
+    }
+    if (!output) {
+        output = fopen(path, "a");
+        if (!output) {
+            return;
+        }
+    }
+
+    fprintf(output,
+            "%" PRIu64 ",%s,%u,%p,%" PRIu64 ",%" PRIu64 ",%" PRIu64
+            ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%d,%d,%d\n",
+            ++sequence, event, texture_idx, binding, texture_offset,
+            texture_length, palette_offset, palette_length, content_hash,
+            stored_hash, content_changed, upload_succeeded, dirty_hint);
+    fflush(output);
+}
+
+#define PGRAPH_VK_TEXTURE_REVALIDATION_TEST_EVENT(...) \
+    pgraph_vk_texture_revalidation_test_event(__VA_ARGS__)
+#endif
